<?xml version="1.0" encoding="utf-8"?>
<!-- Le dossier d'où l'APK de mise à jour est présenté au système. Depuis
     Android 7, livrer un file:// à une autre application lève une exception :
     il faut passer par un content:// servi par le FileProvider. -->
<paths>
    <cache-path name="updates" path="updates/" />
    <!-- Les journaux, pour les partager vers l'autre installation. Même
         raison : un file:// ne se donne pas à une autre application. -->
    <files-path name="movements" path="movements/" />
</paths>
